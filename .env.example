# URL RAÍZ del backend (FastAPI), SIN el sufijo /api/v1: el adaptador lo añade.
# Se usa cuando VITE_USE_MOCK=false.
#   Local:      http://localhost:8000
#   Producción: https://spazio-api.onrender.com
VITE_API_URL=http://localhost:8000

# true = usa el adaptador mock en memoria (sin backend). false = backend real.
VITE_USE_MOCK=true
